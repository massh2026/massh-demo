rules_version = '2';

// =====================================================================
//  MASSH デモ用の Firestore ルール
//  授業のデモのため、だれでも読み書きできる設定にしています。
//  発表が終わったら Firebase のプロジェクトを削除するか、write を false にしてください。
//  本番では Firebase Authentication でログインしたお店だけが status を書き込めるようにします。
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /status/{shopId} { allow read, write: if true; }   // お店ごとの混雑・待ち組数・Bluetoothの台数
    match /seats/{seatId}  { allow read, write: if true; }   // 学食の席（QRチェックイン）
    match /reports/{id}    { allow read, write: if true; }   // 利用者の「空いてた／混んでた」投稿
  }
}
